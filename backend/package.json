{
  "name": "@sovra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "demo:cleanup": "node --env-file-if-exists=.env dist/scripts/demo-cleanup.js",
    "jobs:run": "node --env-file-if-exists=.env dist/scripts/run-jobs.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:build": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --enable-source-maps --test \"dist-test/**/*.spec.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.10",
    "@mysten/sui": "^2.38.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
