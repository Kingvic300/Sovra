# Copy to .env and fill in. This file is read by `npm run start:dev` and `npm run start:prod`.
# Everything except SESSION_SECRET is optional: missing keys make the matching routes
# answer 503 {"error":{"code":"not_configured"}} instead of crashing.

# Required. Long random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# HTTP port and the frontend origin allowed by CORS (cookies are sent with credentials).
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Number of proxies in front of the API (1 behind a single load balancer), or "false" if clients
# connect directly. Wrong values let clients fake their IP and dodge per-IP rate limits.
TRUST_PROXY=1

# Rate limits (defaults shown). Counted in memory per instance.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEMO_PER_HOUR=10
RATE_LIMIT_ASK_PER_HOUR=30
RATE_LIMIT_IMPORT_PER_HOUR=30
RATE_LIMIT_DEMO_ASK_PER_HOUR=10
RATE_LIMIT_WALLET_SYNC_PER_HOUR=12
RATE_LIMIT_EXPORT_PER_HOUR=10

# Pages of 50 transactions read per Sui wallet sync; longer histories continue on the next sync.
WALLET_SYNC_MAX_PAGES=10

# Scheduled jobs (demo cleanup + reminders). A platform cron POSTs /api/internal/jobs/run with
# "Authorization: Bearer <CRON_SECRET>" (at least 32 characters; unset disables the endpoint),
# or runs `npm run jobs:run`. JOBS_INTERVAL_MINUTES>0 runs them in-process on always-on hosts only.
CRON_SECRET=
JOBS_INTERVAL_MINUTES=0
REMINDER_DAYS_AHEAD=3

# Hours a demo account lives before it and its data are deleted.
DEMO_TTL_HOURS=24

# Postgres connection string (Neon, Supabase, Railway, local). Run `npm run db:migrate` after setting it.
DATABASE_URL=

# Tatum API key (dashboard.tatum.io). Used for Sui mainnet reads through
# https://sui-mainnet.gateway.tatum.io/graphql with the `x-api-key` header.
TATUM_API_KEY=

# Walrus Memory (memory.walrus.xyz). MEMWAL_KEY is the delegate PRIVATE key: secret, server only.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Groq (console.groq.com/keys). Powers Ask Sovra and CSV categorization. Secret, server only.
# Without it, /api/ask answers 503 not_configured and imports use keyword rules.
GROQ_API_KEY=
# Production models on Groq's developer plan (console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
