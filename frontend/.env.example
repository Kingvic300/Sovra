# Copy to .env.local and fill in. Only VITE_ variables reach the browser,
# so never put secret keys (Tatum, Walrus delegate key, LLM) here.

# zkLogin through Enoki: https://portal.enoki.mystenlabs.com
# Create a public API key, enable zkLogin for mainnet, and add your Google client ID.
VITE_ENOKI_API_KEY=

# Google Cloud console > Credentials > OAuth client ID (Web application).
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI:      http://localhost:5173/auth/callback
VITE_GOOGLE_CLIENT_ID=
