{
    "rewrites": [
        { "source": "/api/:path*", "destination": "https://sovra-xck3.onrender.com/api/:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/((?!api/).*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://fullnode.mainnet.sui.io https://api.slush.app https://my.slush.app; frame-src https://my.slush.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
                },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
                { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
            ]
        }
    ]
}
